# Gemini API Key - injected automatically by AI Studio at runtime or provided in deployment
GEMINI_API_KEY=""

# Gemini Model configuration (defaults to gemini-2.5-flash with fallback)
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"

# Server configuration
PORT=3000
FASTAPI_PORT=8000
ENVIRONMENT="development"